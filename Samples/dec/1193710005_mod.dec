# same BF as in the updated DECAY_BELLE2.dec (as of April 12th 2018)
Decay anti-B0sig  # Updated to PDG 2017 b -> c semileptonic

0.00704    D_1+sig      e-   anti-nu_e    LLSW 0.71 -1.6 -0.5 2.9;
0.00362    D_0*+sig     e-   anti-nu_e    LLSW 0.68 -0.2 0.3;
0.00401    D'_1+sig     e-   anti-nu_e    LLSW 0.68 -0.2 0.3;
0.00347    D_2*+sig     e-   anti-nu_e    LLSW 0.71 -1.6 -0.5 2.9;

# the values below give a rough estimate of max. allowed BF taking into uncertainties
0.00092   D*0     pi+   e-   anti-nu_e    GOITY_ROBERTS;
0.00046   D*+sig  pi0   e-   anti-nu_e    GOITY_ROBERTS;
0.00092   D0      pi+   e-   anti-nu_e    GOITY_ROBERTS;
0.00046   D+sig   pi0   e-   anti-nu_e    GOITY_ROBERTS;
# the B->Dpipilnu is the measured rate not covered by B->D_1lnu; D_1->Dpipi; modes with pi0 are infered asuming isospin symmetry
0.00021  D+sig pi+ pi-  e-   anti-nu_e    PHSP;
0.00014  D0    pi+ pi0  e-   anti-nu_e    PHSP;
0.00014  D+sig pi0 pi0  e-   anti-nu_e    PHSP;
# B->D*pipilnu ; modes with pi0 are infered asuming isospin symmetry
0.00105  D*+sig pi+ pi- e-   anti-nu_e    PHSP;
0.00070  D*0    pi+ pi0 e-   anti-nu_e    PHSP;
0.00070  D*+sig pi0 pi0 e-   anti-nu_e    PHSP;
# fill the gap between inclusive B->X_clnu and sum of exclusive with hypothetical decay (unmeasured)
0.00217  D+sig  eta     e-   anti-nu_e    PHSP;
0.00217  D*+sig eta     e-   anti-nu_e    PHSP;


0.00704  D_1+sig    mu-  anti-nu_mu           LLSW 0.71 -1.6 -0.5 2.9;
0.00362  D_0*+sig   mu-  anti-nu_mu           LLSW 0.68 -0.2 0.3;
0.00401  D'_1+sig   mu-  anti-nu_mu           LLSW 0.68 -0.2 0.3;
0.00347  D_2*+sig   mu-  anti-nu_mu           LLSW 0.71 -1.6 -0.5 2.9;
# the measured modes are already covered by B->X_clnu; X_c->D(*)pi
0.00092   D*0  pi+   mu-  anti-nu_mu       GOITY_ROBERTS; 
0.00046   D*+sig  pi0   mu-  anti-nu_mu       GOITY_ROBERTS;
0.00092   D0   pi+   mu-  anti-nu_mu       GOITY_ROBERTS;
0.00046   D+sig   pi0   mu-  anti-nu_mu       GOITY_ROBERTS;
# the B->Dpipilnu is the measured rate not covered by B->D_1lnu; D_1->Dpipi; modes with pi0 are infered asuming isospin symmetry
0.00021  D+sig pi+ pi- mu-   anti-nu_mu        PHSP;
0.00014  D0 pi+ pi0 mu-   anti-nu_mu        PHSP;
0.00014  D+sig pi0 pi0 mu-   anti-nu_mu        PHSP;
# B->D*pipilnu ; modes with pi0 are infered asuming isospin symmetry
0.00105  D*+sig pi+ pi- mu-   anti-nu_mu        PHSP;
0.00070  D*0 pi+ pi0 mu-   anti-nu_mu        PHSP;
0.00070  D*+sig pi0 pi0 mu-   anti-nu_mu        PHSP;
# fill the gap between inclusive B->X_clnu and sum of exclusive with hypothetical decay (unmeasured)
0.00217  D+sig  eta  mu-   anti-nu_mu        PHSP;
0.00217  D*+sig eta  mu-   anti-nu_mu        PHSP;
Enddecay

